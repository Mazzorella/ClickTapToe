#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        /* Yamaha-style pedals short to GND at rest and open when pressed. */
        input-gpios = <
            &xiao_d 0 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH) /* D0 */
            &xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH) /* D1 */
            &xiao_d 2 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH) /* D2 / future footswitch/TTS/spare */
            &xiao_d 3 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH) /* D3 / future footswitch/TTS/spare */
        >;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <4>;
        map = <RC(0,0) RC(0,1) RC(0,2) RC(0,3)>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&scroll_as5600>;
        triggers-per-rotation = <24>;
    };

    pmw3610_listener: pmw3610_listener {
        compatible = "zmk,input-listener";
        device = <&pmw3610>;
    };
};

/* D6 is routed to PMW3610 nRESET; this diagnostic firmware uses the original SPI reset path. */

&xiao_i2c {
    status = "okay";

    scroll_as5600: as5600_scroll@36 {
        compatible = "clicktaptoe,as5600-scroll";
        reg = <0x36>;
        poll-ms = <8>;
        deadband = <0>;
        status = "okay";
    };
};

&spi2_default {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,  /* D8 */
            <NRF_PSEL(SPIM_MOSI, 1, 15)>,     /* D10 / PMW3610 SDIO */
            <NRF_PSEL(SPIM_MISO, 1, 15)>;     /* D10 / PMW3610 SDIO */
    };
};

&spi2_sleep {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,  /* D8 */
            <NRF_PSEL(SPIM_MOSI, 1, 15)>,     /* D10 / PMW3610 SDIO */
            <NRF_PSEL(SPIM_MISO, 1, 15)>;     /* D10 / PMW3610 SDIO */
        low-power-enable;
    };
};

&xiao_spi {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>; /* D9 / PMW3610 nCS */

    pmw3610: pmw3610@0 {
        compatible = "pixart,pmw3610-alt";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D7 / PMW3610 MOT */
        cpi = <600>;
        swap-xy;
        invert-y;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};
